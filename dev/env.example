# إعدادات التطوير المحلي — انسخ القيم هنا، والملف ده (dev/.env) مش بيترفع على جيت.
# ⚠ متحطش هنا مفاتيح السيرفر الحقيقي (واتساب/الإيميل) عشان النسخة المحلية متبعتش رسايل حقيقية.

# ── الربط بداتا السنترال (قراءة بس) عن طريق نفق SSH ──
# 1) شغّل النفق في نافذة لوحده:  ssh -i central1.pem -N -L 3307:127.0.0.1:3306 admin@3.89.245.93
# 2) حط بيانات يوزر القراءة (شوف DEVELOPMENT.md ← "يوزر قراءة بس")
NQ_DB_HOST=127.0.0.1
NQ_DB_PORT=3307
NQ_DB_USER=
NQ_DB_PASS=

NQ_TZ=Asia/Riyadh
NQ_HOST=3.89.245.93.sslip.io

