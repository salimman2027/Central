{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "السيرفر (تشغيل عادي)",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/dev/run.py",
      "console": "integratedTerminal"
    },
    {
      "name": "السيرفر (Debug — نقاط توقف)",
      "type": "debugpy", "request": "launch", "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "8090"],
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/dev/.env",
      "env": {
        "NQ_CONF": "${workspaceFolder}/.devdata/conf",
        "NQ_DATA": "${workspaceFolder}/.devdata/data",
        "NQ_MONITOR": "${workspaceFolder}/.devdata/monitor",
        "NQ_NO_MONITOR": "1", "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal"
    }
  ]
}
